<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="collective.blicca.galleryreflist">

  <i18n:registerTranslations directory="locales" />

  <include file="permissions.zcml" />

  <genericsetup:registerProfile
      name="default"
      title="Collective Blicca Galleryreflist"
      description="Gallery section block for the Aurora editor: a heading, a text and a Reference List composed into one block, with registrable styles"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Collective Blicca Galleryreflist (uninstall)"
      description="Uninstalls collective.blicca.galleryreflist"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <genericsetup:importStep
      name="collective.blicca.galleryreflist-uninstall"
      title="Collective Blicca Galleryreflist uninstall"
      description="Uninstall collective.blicca.galleryreflist"
      handler="collective.blicca.galleryreflist.setuphandlers.uninstall"
      />


  <include package=".vocabularies" />

</configure>
