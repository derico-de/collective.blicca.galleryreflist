<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="collective.blicca.galleryreflist">

  <genericsetup:registerProfile
      name="1001"
      title="collective.blicca.galleryreflist: upgrade to 1001"
      directory="1001"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1000"
      destination="1001"
      profile="collective.blicca.galleryreflist:default">

    <genericsetup:upgradeStep
        title="Register the block"
        description="Add the block add-on record."
        handler=".v1001.upgrade"
        />

  </genericsetup:upgradeSteps>

</configure>
