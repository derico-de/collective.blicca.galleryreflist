<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="collective.blicca.galleryreflist">

  <genericsetup:upgradeSteps
      source="1002"
      destination="1003"
      profile="collective.blicca.galleryreflist:default">

    <genericsetup:upgradeStep
        title="Remove the derico.blicca.gallerysection leftovers"
        description="Drop the browser layer, block add-on records and profile version of the package this one replaces."
        handler=".v1003.upgrade"
        />

  </genericsetup:upgradeSteps>

</configure>
