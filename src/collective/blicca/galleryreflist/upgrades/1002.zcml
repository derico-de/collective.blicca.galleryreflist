<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="collective.blicca.galleryreflist">

  <genericsetup:registerProfile
      name="1002"
      title="collective.blicca.galleryreflist: upgrade to 1002"
      directory="1002"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1001"
      destination="1002"
      profile="collective.blicca.galleryreflist:default">

    <genericsetup:upgradeStep
        title="Use the editor&#39;s block styles"
        description="Move the styles into plone.blicca.auroraeditor&#39;s block_styles record and drop this package&#39;s own."
        handler=".v1002.upgrade"
        />

  </genericsetup:upgradeSteps>

</configure>
